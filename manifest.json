{
  "manifest_version": 3,
  "name": "Trimwise Forfoxxx",
  "version": "2.1.12",
  "description": "Trimwise Forfoxxx Firefox add-on: virtual scrolling, adaptive queueing, and message collapse for long ChatGPT chats",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "shnxxx@trimwise.firefox",
      "strict_min_version": "121.0"
    }
  }
}
